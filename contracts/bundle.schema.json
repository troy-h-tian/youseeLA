        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "recommendation_reason": {
          "title": "Recommendation Reason",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "verified_at": {
          "format": "date",
          "title": "Verified At",
          "type": "string"
        },
        "website_url": {
          "title": "Website Url",
          "type": "string"
        },
        "directions_url": {
          "title": "Directions Url",
          "type": "string"
        },
        "data_kind": {
          "default": "real",
          "enum": [
            "real",
            "fixture"
          ],
          "title": "Data Kind",
          "type": "string"
