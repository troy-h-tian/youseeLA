{
  "$defs": {
    "Area": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "geometry": {
          "additionalProperties": true,
          "title": "Geometry",
          "type": "object"
        },
        "indicators": {
          "$ref": "#/$defs/NumericalIndicators"
        },
        "boundary_source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Source Url"
        },
        "boundary_vintage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary Vintage"
        },
        "context": {
          "items": {
            "$ref": "#/$defs/ContextIndicator"
          },
          "title": "Context",
          "type": "array"
        },
        "reference_typology": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceTypology"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/Prediction"
          },
          "title": "Predictions",
          "type": "array"
        },
        "housing": {
          "$ref": "#/$defs/Assessment"
        },
        "commercial": {
          "$ref": "#/$defs/Assessment"
        }
      },
      "required": [
        "id",
        "name",
        "geometry",
        "indicators",
        "housing",
        "commercial"
      ],
      "title": "Area",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "housing",
            "commercial"
          ],
          "title": "Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "rated",
            "insufficient_evidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "lower",
                "moderate",
                "higher"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "contributions": {
          "items": {
            "$ref": "#/$defs/Contribution"
          },
          "title": "Contributions",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "configuration_version": {
          "default": "experimental-v1",
          "title": "Configuration Version",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        }
      },
      "required": [
        "mode",
        "status"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Business": {
      "additionalProperties": false,
