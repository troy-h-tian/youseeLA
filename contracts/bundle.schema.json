        "business_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Type"
        },
        "opened_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened Year"
        },
        "opened_source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened Source Url"
        },
        "opened_note": {
          "default": "",
          "title": "Opened Note",
          "type": "string"
        },
        "outlook": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusinessOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
